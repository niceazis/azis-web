{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "azis-web",
  "main": "src/index.js",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ANTHROPIC_MODEL": "claude-haiku-4-5"
  },
  "ratelimits": [
    {
      "name": "ANALYSIS_LIMITER",
      "namespace_id": "2026100901",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
